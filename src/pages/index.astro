---
import Seccion from "../components/Seccion.astro";
import Layout  from "../layouts/Layout.astro";
import Cita from "../components/Cita.astro";
import Modal from "../components/Modal.astro";
---
<Layout>
<Seccion class="bg-gray-100">
  <h1 class="text-4xl font-bold text-gray-900">
    Bienvenidos a mi landing page
  </h1>
  <p class="mt-4 text-gray-600">
    Creamos soluciones para ti.
  </p>
</Seccion>

<Seccion class="bg-blue-600 text-white">
  <h2 class="text-3xl font-bold">
    Nuestros servicios
  </h2>
  <p class="mt-4">
    Conoce todos los servicios que ofrecemos.
  </p>
</Seccion>

<Seccion class="bg-gray-900 text-white">
  <h2 class="text-3xl font-bold">
    Contáctanos
  </h2>
  <p class="mt-4">
    Estamos aquí para ayudarte.
  </p>
</Seccion>
<Cita autor="Albert Einstein">
  La imaginación es más importante que el conocimiento.
</Cita>

<Cita autor="Steve Jobs">
  La única manera de hacer un gran trabajo es amar lo que haces.
</Cita>
<Modal titulo="Registro de usuario">
  <form class="space-y-4">
    <input
      type="text"
      placeholder="Nombre"
      class="w-full border p-2 rounded"
    />

    <input
      type="email"
      placeholder="Correo electrónico"
      class="w-full border p-2 rounded"
    />

    <button class="bg-blue-600 text-white px-4 py-2 rounded">
      Registrarse
    </button>
  </form>
</Modal>
</Layout>